# Vivado generated files
*.jou
*.str
*.pid
*.backup.jou
*.backup.log
vivado_run*.log
vivado_impl_only.log
vivado_reports.log
.Xil/
*.pb
*.wdb
*.wcfg
*.wdf
*.wpc
*.lpr
xsim.dir/
*.sdb
*.rlx
*.rtti
*.svtype
*.type
*.xdbg
*.dbg
*.mem_dmp
*.reloc
*.xsimcrash.log
*.xsimkernel.log
xsimSettings.ini
Compile_Options.txt
TempBreakPointFile.txt

# Vivado project cache (keep .xpr and .xdc, skip cache/runs)
*.cache/
*.sim/
*.runs/synth_1/
*.runs/impl_1/
*.ip_user_files/
*.hw/

# Large simulation output files
*.vcd
*.fsdb
*.out

# Compiled simulation objects
simv_*
compile_*.log
sim_*.log
*.lnx64.o
*.c

# Cadence Genus/Innovus
*.cmd
*.genus.log
*.innovus.log
genus.cmd.log
innovus.cmd.log

# OS files
.DS_Store
Thumbs.db
*.swp
*~

# Python cache
__pycache__/
*.pyc

# ELF and binaries — keep .bit, .bin, .mem but skip intermediate objects
*.o
*.elf
*.bin
# Keep bitstream and program memory:
!fpga/bitstream/*.bit
!fpga/bitstream/*.bin
!sw/program.mem
